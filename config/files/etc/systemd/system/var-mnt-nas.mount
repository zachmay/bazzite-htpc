[Unit]
Description=NAS Media Share (yesod)
After=network-online.target
Requires=network-online.target

[Mount]
What=//192.168.7.243/Media
Where=/var/mnt/nas
Type=cifs
Options=credentials=/etc/samba/nas-credentials,uid=1000,gid=1000,iocharset=utf8,x-systemd.idle-timeout=0

[Install]
WantedBy=multi-user.target
