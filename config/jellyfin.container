[Unit]
Description=Jellyfin Media Server
After=network-online.target

[Container]
Image=docker.io/jellyfin/jellyfin:latest
PublishPort=8096:8096
Environment=TZ=America/New_York
# :Z relabels these host dirs to container_file_t — without it SELinux denies
# writes to config_home_t and Jellyfin dies on '/config/log access denied'.
Volume=%h/.config/jellyfin/config:/config:Z
Volume=%h/.config/jellyfin/cache:/cache:Z
# No :Z here — CIFS has no xattrs; the share is labeled via context= in
# var-mnt-nas.mount instead.
Volume=/var/mnt/nas:/media:ro
AddDevice=/dev/dri
AutoUpdate=registry

[Service]
Restart=always
# Default RestartSec=100ms burns StartLimitBurst in ~2s and the unit gives up
# permanently. Back off so a late NAS or network recovers on its own.
RestartSec=10
# User units can't order against the system automount, so force it to trigger
# before podman resolves the bind-mount path.
ExecStartPre=/usr/bin/test -d /var/mnt/nas/Movies
