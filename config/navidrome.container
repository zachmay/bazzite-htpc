[Unit]
Description=Navidrome Music Server
After=network-online.target local-fs.target var-mnt-nas.mount

[Container]
Image=docker.io/deluan/navidrome:latest
PublishPort=4533:4533
Environment=TZ=America/New_York
Environment=ND_MUSICFOLDER=/music
Volume=%h/.config/navidrome/data:/data
Volume=/var/mnt/nas/Music:/music:ro
AutoUpdate=registry

[Service]
Restart=always
