[Unit]
Description=Navidrome Music Server
After=network-online.target

[Container]
Image=docker.io/deluan/navidrome:latest
PublishPort=4533:4533
Environment=TZ=America/New_York
Environment=ND_MUSICFOLDER=/music
# :Z relabels to container_file_t — see jellyfin.container.
Volume=%h/.config/navidrome/data:/data:Z
# No :Z — CIFS is labeled via context= in var-mnt-nas.mount.
Volume=/var/mnt/nas/Music:/music:ro
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10
# Triggers the autofs mount before podman statfs's the path, which otherwise
# fails with 'no such device'.
ExecStartPre=/usr/bin/test -d /var/mnt/nas/Music

# See jellyfin.container — required for the service to start at boot.
[Install]
WantedBy=default.target
